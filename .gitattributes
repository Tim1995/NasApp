# 统一换行符，避免 Windows 上 clone 之后 shell 脚本跑不起来
* text=auto

# macOS / Linux 的启动脚本必须是 LF，否则会报 "bad interpreter"
*.sh        text eol=lf
*.command   text eol=lf

# Windows 批处理要用 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# 图片等二进制文件不要做任何转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.zip       binary

# 让 GitHub 的语言统计更准确
assets/vendor/** linguist-vendored
